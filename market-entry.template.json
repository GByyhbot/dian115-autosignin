{
  "schema_version": 1,
  "id": "community.dian115-autosignin",
  "name": "站点自动签到",
  "version": "1.0.1",
  "description": "按计划自动签到、模拟登录 PT 站点并发送通知，适配自 MoviePilot autosignin 3.0.3。",
  "author": "GByyhbot",
  "homepage": "https://github.com/GByyhbot/dian115-autosignin",
  "package_url": "https://github.com/GByyhbot/dian115-autosignin/releases/download/v1.0.1/community.dian115-autosignin-1.0.1.d115p",
  "sha256": "REPLACED_BY_PACKAGER",
  "runtime": {
    "kind": "wasm",
    "protocol": "dian115:wasm@1",
    "autostart": true,
    "trust_level": "wasm-sandbox"
  },
  "permissions": {
    "apis": [
      {
        "path": "/api/plugin-runtime/storage/:key",
        "method": "GET",
        "reason": "读取插件站点配置、签到历史和运行状态"
      },
      {
        "path": "/api/plugin-runtime/storage/:key",
        "method": "PUT",
        "reason": "保存插件站点配置、签到历史和运行状态"
      },
      {
        "path": "/api/notifications/plugin",
        "method": "POST",
        "reason": "发送用户启用的签到与模拟登录结果通知"
      }
    ],
    "network": []
  },
  "tags": [
    "pt",
    "automation",
    "signin"
  ]
}
