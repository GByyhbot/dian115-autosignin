{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/7637a392e9512bd0f7965b99445768969eb075fc/docs/plugin-platform/manifest.schema.json",
  "schema_version": 1,
  "id": "community.dian115-autosignin",
  "name": "站点自动签到",
  "version": "1.1.1",
  "description": "按计划自动签到、模拟登录 PT 站点并发送通知，适配自 MoviePilot autosignin 3.0.3。",
  "default_locale": "zh-CN",
  "publisher": {
    "name": "GByyhbot",
    "key_id": "ed25519:REPLACED_BY_PACKAGER",
    "url": "https://github.com/GByyhbot/dian115-autosignin"
  },
  "compatibility": {
    "dian115": ">=3.8.51 <6.0.0",
    "plugin_api": "^2.0"
  },
  "runtime": {
    "kind": "wasm",
    "entry": "runtime/plugin.wasm",
    "protocol": "dian115:wasm@1",
    "startup_timeout_ms": 10000,
    "shutdown_timeout_ms": 5000,
    "timeout_ms": 120000,
    "background_timeout_ms": 3600000,
    "max_concurrency": 1,
    "restart_policy": "on-failure",
    "memory_mb": 128,
    "resident": true
  },
  "permissions": {
    "apis": [
      {
        "path": "/api/plugin-runtime/storage/:key",
        "method": "GET",
        "reason": "读取插件站点配置、签到历史和运行状态"
      },
      {
        "path": "/api/plugin-runtime/storage/:key",
        "method": "PUT",
        "reason": "保存插件站点配置、签到历史和运行状态"
      },
      {
        "path": "/api/notifications/plugin",
        "method": "POST",
        "reason": "发送用户启用的签到与模拟登录结果通知"
      }
    ],
    "network": [
      {"origin": "https://52pt.site", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 52PT 执行签到与登录请求"},
      {"origin": "https://pt.btschool.club", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 BTSchool 执行签到与登录请求"},
      {"origin": "https://ptchdbits.co", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 CHDBits 执行签到与登录请求"},
      {"origin": "https://haidan.cc", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 HaiDan 执行签到与登录请求"},
      {"origin": "https://club.hares.top", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 Hares 执行签到与登录请求"},
      {"origin": "https://hdarea.club", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 HDArea 执行签到与登录请求"},
      {"origin": "https://hdchina.org", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 HDChina 执行签到与登录请求"},
      {"origin": "https://hdcity.city", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 HDCity 执行签到与登录请求"},
      {"origin": "https://hdsky.me", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 HDSky 执行签到与登录请求"},
      {"origin": "https://pt.hdupt.com", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 HDUPT 执行签到与登录请求"},
      {"origin": "https://kp.m-team.cc", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 M-Team 执行签到与登录请求"},
      {"origin": "https://v6.nexushd.org", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 NexusHD 执行签到与登录请求"},
      {"origin": "https://open.cd", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 OpenCD 执行签到与登录请求"},
      {"origin": "https://pterclub.com", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 PTerClub 执行签到与登录请求"},
      {"origin": "https://pttime.org", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 PTTime 执行签到与登录请求"},
      {"origin": "https://ptzone.xyz", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 PTZONE 执行签到与登录请求"},
      {"origin": "https://rousi.pro", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 Rousi Pro 执行签到与登录请求"},
      {"origin": "https://tjupt.org", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 TJUPT 执行签到与登录请求"},
      {"origin": "https://totheglory.im", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 TTG 执行签到与登录请求"},
      {"origin": "https://u2.dmhy.org", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 U2 执行签到与登录请求"},
      {"origin": "https://yemapt.org", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 YemaPT 执行签到与登录请求"},
      {"origin": "https://zhuque.in", "methods": ["GET", "POST"], "proxy_mode": "system", "reason": "对 ZHUQUE 执行签到与登录请求"}
    ]
  },
  "ui": {
    "mode": "federation",
    "icon": "frontend/icon.svg",
    "federation": {
      "entry": "frontend/dist/assets/remoteEntry.js",
      "assets_root": "frontend/dist/assets",
      "module": "./AppPage"
    }
  },
  "events": [],
  "jobs": [],
  "homepage": "https://github.com/GByyhbot/dian115-autosignin",
  "repository": "https://github.com/GByyhbot/dian115-autosignin",
  "license": "NOASSERTION",
  "tags": [
    "pt",
    "automation",
    "signin"
  ]
}
