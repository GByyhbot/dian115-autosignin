{
  "schema_version": 1,
  "repository": {
    "id": "community.dian115-autosignin",
    "name": "DIAN115 AutoSignIn 插件仓库",
    "homepage": "https://github.com/GByyhbot/dian115-autosignin"
  },
  "plugins": [
    {
      "id": "community.dian115-autosignin",
      "name": "站点自动签到",
      "version": "1.1.0",
      "description": "按计划自动签到、模拟登录 PT 站点并发送通知，适配自 MoviePilot autosignin 3.0.3；支持宿主托管凭据（credential_ref）。",
      "author": "GByyhbot",
      "homepage": "https://github.com/GByyhbot/dian115-autosignin",
      "package_url": "https://github.com/GByyhbot/dian115-autosignin/releases/download/v1.1.0/community.dian115-autosignin-1.1.0.d115p",
      "sha256": "52129faf8b7f9bdabeb546fd0531ce89cc474d8e0dd84dac09e9a4b182e37e14",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "path": "/api/plugin-runtime/storage/:key",
            "method": "GET",
            "reason": "读取插件站点配置、签到历史和运行状态"
          },
          {
            "path": "/api/plugin-runtime/storage/:key",
            "method": "PUT",
            "reason": "保存插件站点配置、签到历史和运行状态"
          },
          {
            "path": "/api/notifications/plugin",
            "method": "POST",
            "reason": "发送用户启用的签到与模拟登录结果通知"
          }
        ],
        "network": []
      },
      "tags": [
        "pt",
        "automation",
        "signin"
      ]
    }
  ]
}
