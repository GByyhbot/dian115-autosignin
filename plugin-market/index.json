  },
  "plugins": [
    {
      "id": "community.dian115-autosignin",
      "name": "站点自动签到",
      "version": "1.3.0",
      "description": "按计划自动签到、模拟登录 PT 站点并发送通知，支持 CookieCloud 凭据同步与直填，适配自 MoviePilot autosignin 3.0.3。",
      "author": "GByyhbot",
      "homepage": "https://github.com/GByyhbot/dian115-autosignin",
      "package_url": "https://github.com/GByyhbot/dian115-autosignin/releases/download/v1.3.0/community.dian115-autosignin-1.3.0.d115p",
      "sha256": "3d4deeea1e90fa04b903cc739b647fcdd1fdb2dee814748aedd5fe36f281ca68",
      "runtime": {
        "kind": "wasm",
        "protocol": "dian115:wasm@1",
        "autostart": true,
        "trust_level": "wasm-sandbox"
      },
      "permissions": {
        "apis": [
          {
            "path": "/api/plugin-runtime/storage/:key",
            "method": "GET",
            "reason": "读取插件站点配置、签到历史和运行状态"
          },
          {
            "path": "/api/plugin-runtime/storage/:key",
            "method": "PUT",
            "reason": "保存插件站点配置、签到历史和运行状态"
          },
          {
            "path": "/api/notifications/plugin",
            "method": "POST",
            "reason": "发送用户启用的签到与模拟登录结果通知"
          },
          {
            "path": "/api/plugin-runtime/http/cookies",
            "method": "GET",
            "reason": "读取站点受管会话的 Cookie 状态与数量"
          },
          {
            "path": "/api/plugin-runtime/http/cookies",
            "method": "PUT",
            "reason": "把用户直填的站点 Cookie 持久化到受管会话"
          },
          {
            "path": "/api/plugin-runtime/http/cookies",
            "method": "DELETE",
            "reason": "清空站点受管 Cookie 会话"
          },
          {
            "path": "/api/plugin-runtime/http/cookiecloud",
            "method": "GET",
            "reason": "读取宿主本地 CookieCloud 概况供按域名导入"
          },
          {
            "path": "/api/plugin-runtime/http/cookiecloud/import",
            "method": "POST",
            "reason": "从 CookieCloud 按站点域名导入 Cookie 到受管会话"
          },
          {
            "path": "/api/plugin-runtime/http/sites",
            "method": "GET",
            "reason": "读取自定义站点地址列表"
          },
          {
            "path": "/api/plugin-runtime/http/sites",
            "method": "PUT",
            "reason": "保存自定义站点地址并纳入 CookieCloud 凭据范围"
          },
          {
            "path": "/api/plugin-runtime/http/sites",
            "method": "DELETE",
            "reason": "删除自定义站点地址"
          }
        ],
        "network": [
          {
            "origin": "https://52pt.site",
            "methods": [
              "GET",
              "POST"
            ],
